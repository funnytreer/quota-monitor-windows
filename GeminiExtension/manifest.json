{
  "manifest_version": 3,
  "name": "额度监控器 · Gemini",
  "description": "将 Gemini 用量页上的剩余额度与重置时间传给本机的额度监控器。",
  "version": "1.0.0",
  "key": "",
  "background": { "service_worker": "browser.js", "type": "module" },
  "action": { "default_title": "连接或刷新 Gemini 额度" },
  "permissions": ["alarms", "nativeMessaging", "scripting"],
  "optional_host_permissions": ["https://gemini.google.com/*"]
}
