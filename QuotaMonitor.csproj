<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.10240.0</SupportedOSPlatformVersion>
    <!-- Preserve the launcher path used by desktop shortcuts and startup. -->
    <BaseOutputPath Condition="'$(BaseOutputPath)' == ''">bin\</BaseOutputPath>
    <OutputPath>$(BaseOutputPath)$(Configuration)\net8.0-windows\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>QuotaMonitor.ico</ApplicationIcon>
    <AssemblyTitle>额度监控器</AssemblyTitle>
    <Product>额度监控器</Product>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);QuotaMonitor.Tests/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="QuotaMonitor.Tests" />
    <!-- Lobe Icons, MIT. Originals from https://github.com/lobehub/lobe-icons/tree/05260484d9f4de68f90cc87a634ae68fa4043efd/packages/static-svg/icons -->
    <EmbeddedResource Include="UI/Assets/Brands/*.svg" LogicalName="QuotaMonitor.Brands.%(Filename)%(Extension)" />
    <EmbeddedResource Include="UI/Assets/Brands/LICENSE.txt" LogicalName="QuotaMonitor.Brands.LICENSE.txt" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
</Project>
